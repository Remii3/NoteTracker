{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notetracker-topic-images",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "notetracker-images",
    },
  ],
}
