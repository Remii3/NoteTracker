---
type Props = {
  compact?: boolean;
  inverted?: boolean;
};

const { compact = false, inverted = false } = Astro.props;
---

<a class:list={["brand", { inverted }]} href="/" aria-label="Sylabio — strona główna">
  <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true">
    <path d="M9 10.5C9 8.57 10.57 7 12.5 7H28a3 3 0 0 1 3 3v20.25a.75.75 0 0 1-1.12.65c-3.8-2.17-7.1-2.14-9.88.08-2.78-2.22-6.08-2.25-9.88-.08A.75.75 0 0 1 9 30.25V10.5Z" fill="currentColor" opacity=".16" />
    <path d="M20 11.5v19M11.5 10.5c3.3-1.55 6.13-1.22 8.5 1v19.48c-2.78-2.22-6.08-2.25-9.88-.08A.75.75 0 0 1 9 30.25V12.79c0-.97.96-1.82 2.5-2.29Zm17 0c-3.3-1.55-6.13-1.22-8.5 1v19.48c2.78-2.22 6.08-2.25 9.88-.08a.75.75 0 0 0 1.12-.65V12.79c0-.97-.96-1.82-2.5-2.29Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
    <path d="m14.25 17.5 2.15 2.15 5-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
  </svg>
  {!compact && <span>Sylabio</span>}
</a>

<style>
  .brand { display: inline-flex; align-items: center; gap: .7rem; color: var(--ink); font-size: 1.18rem; font-weight: 760; letter-spacing: -.035em; text-decoration: none; }
  .brand.inverted { color: white; }
  .brand-mark { width: 2rem; height: 2rem; color: var(--brand); }
  .inverted .brand-mark { color: var(--mint); }
</style>
