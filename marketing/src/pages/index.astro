---
import BaseLayout from "../layouts/BaseLayout.astro";
import DashboardPreview from "../components/DashboardPreview.astro";
import { appLinks } from "../config";

const benefits = [
  ["01", "Zbierz materiał", "Twórz przejrzyste notatki lub importuj gotowe materiały. Wszystko zostaje uporządkowane według modułów, rozdziałów i tematów."],
  ["02", "Ustal cel", "Dodaj termin egzaminu. Sylabio rozłoży materiał w czasie i pokaże, czy Twoje tempo pozwala zdążyć bez nauki na ostatnią chwilę."],
  ["03", "Ucz się codziennie", "Otwierasz aplikację i od razu wiesz, co zrobić. Powtórki wracają wtedy, kiedy naprawdę ich potrzebujesz."],
];

const features = [
  { icon: "calendar", title: "Plan, który pilnuje terminu", text: "Plan egzaminu łączy ilość materiału, dostępny czas i Twoje postępy w jeden konkretny harmonogram." },
  { icon: "repeat", title: "Powtórki dopasowane do pamięci", text: "System planuje kolejne spotkanie z materiałem na podstawie historii Twoich odpowiedzi — nie według sztywnego kalendarza." },
  { icon: "spark", title: "Pytania z własnych notatek", text: "Zamieniaj treść notatek w pytania do aktywnej nauki. Generowanie AI jest wsparciem, a Ty zachowujesz kontrolę nad zestawem." },
  { icon: "offline", title: "Nauka także bez internetu", text: "Pracuj nad zapisanymi materiałami offline. Zmiany zsynchronizują się po odzyskaniu połączenia." },
];

const faqs = [
  ["Czy Sylabio jest darmowe?", "Tak. W czasie rozwoju produktu możesz korzystać z dostępnych funkcji bezpłatnie. O przyszłych planach i limitach poinformujemy z wyprzedzeniem."],
  ["Czy muszę od razu tworzyć wszystkie notatki w aplikacji?", "Nie. Możesz zacząć od jednego modułu, wkleić lub zaimportować materiał i od razu przygotować pierwszą sesję nauki."],
  ["Jak działa plan egzaminu?", "Wskazujesz termin, materiał oraz dni, w które możesz się uczyć. Sylabio rozkłada pracę, śledzi wykonanie i sygnalizuje, gdy trzeba zmienić tempo."],
  ["Czy aplikacja działa na telefonie?", "Tak. Sylabio działa w przeglądarce i można je zainstalować jako aplikację PWA na telefonie lub komputerze."],
  ["Czy moje notatki są używane do generowania pytań?", "Tylko wtedy, gdy świadomie uruchomisz funkcję AI dla wybranej treści. Szczegóły przetwarzania opisujemy w polityce prywatności."],
];
---

<BaseLayout title="Sylabio" description="Dodaj materiały, ustaw termin egzaminu i codziennie otrzymuj konkretny plan nauki. Notatki, pytania i inteligentne powtórki w jednym miejscu.">
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Twój spokojny plan do egzaminu</p>
        <h1>Wiesz, czego uczyć się <em>dzisiaj.</em></h1>
        <p class="hero-lead">Dodaj materiały, ustaw termin egzaminu, a Sylabio ułoży codzienny rytm nauki i powtórek. Bez chaosu. Bez zgadywania.</p>
        <div class="hero-actions">
          <a class="button" href={appLinks.signUp}>Zacznij za darmo <span aria-hidden="true">→</span></a>
          <a class="tour-link" href="#jak-to-dziala"><span class="play" aria-hidden="true">▶</span> Zobacz, jak to działa</a>
        </div>
        <div class="hero-proof" aria-label="Najważniejsze informacje">
          <span><i>✓</i> Bez karty płatniczej</span>
          <span><i>✓</i> Działa offline</span>
          <span><i>✓</i> Twoje materiały są prywatne</span>
        </div>
      </div>
      <div class="hero-note" aria-hidden="true">
        <span class="note-dot"></span>
        <p>„Zamiast zastanawiać się, od czego zacząć, po prostu otwierasz plan na dziś.”</p>
        <svg viewBox="0 0 120 54"><path d="M4 45c34 8 70-6 107-36M99 7l14 1-5 13" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
      </div>
    </div>
    <div class="shell hero-preview"><DashboardPreview /></div>
  </section>

  <section class="signal-bar" aria-label="Główne możliwości">
    <div class="shell signals">
      <span>Notatki</span><i>•</i><span>Plan egzaminu</span><i>•</i><span>Inteligentne powtórki</span><i>•</i><span>Pytania z AI</span><i>•</i><span>Tryb offline</span>
    </div>
  </section>

  <section class="section story" id="jak-to-dziala">
    <div class="shell">
      <p class="section-kicker">Prosty proces</p>
      <div class="story-heading">
        <h2 class="section-title">Od sterty materiałów do planu, który da się wykonać.</h2>
        <p class="section-lead">Sylabio łączy przygotowanie materiału, aktywną naukę i pilnowanie terminu. Każdy krok wynika z poprzedniego.</p>
      </div>
      <div class="steps">
        {benefits.map(([number, title, text]) => (
          <article class="step">
            <span class="step-number">{number}</span>
            <div class="step-line"></div>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section plan-section">
    <div class="shell plan-grid">
      <div class="plan-visual" aria-hidden="true">
        <div class="calendar-card">
          <div class="calendar-top"><div><small>TWÓJ CEL</small><strong>Egzamin z biologii</strong></div><span>18 dni</span></div>
          <div class="week"><i>Pn</i><i>Wt</i><i>Śr</i><i>Cz</i><i>Pt</i><i>So</i><i>Nd</i></div>
          <div class="calendar-grid">
            {Array.from({ length: 21 }, (_, i) => <span class:list={{ filled: [1,2,4,7,8,10,11,14].includes(i), today: i === 11, future: i > 11 }}>{i + 1}</span>)}
          </div>
          <div class="pace"><span><i></i> Tempo nauki</span><strong>Zdążysz 3 dni wcześniej</strong></div>
        </div>
        <span class="float-card card-a"><strong>12</strong><small>powtórek dziś</small></span>
        <span class="float-card card-b"><strong>82%</strong><small>planu wykonane</small></span>
      </div>
      <div class="plan-copy">
        <p class="section-kicker">Planowanie bez zgadywania</p>
        <h2 class="section-title">Termin przestaje straszyć, kiedy widzisz drogę.</h2>
        <p class="section-lead">Sylabio rozkłada materiał na dostępne dni, uwzględnia powtórki i pokazuje, czy uczysz się w dobrym tempie.</p>
        <ul>
          <li><span>✓</span><div><strong>Realny plan dnia</strong><p>Tyle zadań, ile mieści się w Twoim czasie.</p></div></li>
          <li><span>✓</span><div><strong>Wczesne ostrzeżenie</strong><p>Widzisz zaległości, zanim staną się problemem.</p></div></li>
          <li><span>✓</span><div><strong>Elastyczne przeliczanie</strong><p>Nie wyszło dziś? Plan dopasuje kolejne dni.</p></div></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section feature-section">
    <div class="shell">
      <p class="section-kicker">Jedno miejsce do nauki</p>
      <h2 class="section-title">Mniej przełączania. Więcej zapamiętywania.</h2>
      <div class="feature-grid">
        {features.map((feature, index) => (
          <article class:list={["feature", `feature-${index + 1}`]}>
            <span class="feature-icon" aria-hidden="true">{feature.icon === "calendar" ? "◫" : feature.icon === "repeat" ? "↻" : feature.icon === "spark" ? "✦" : "⌁"}</span>
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
          </article>
        ))}
      </div>
      <a class="feature-link" href="/features">Poznaj wszystkie możliwości <span>→</span></a>
    </div>
  </section>

  <section class="section quote-section">
    <div class="shell quote-grid">
      <div class="quote-copy">
        <span class="quote-mark">“</span>
        <h2>Nie potrzebujesz kolejnej listy rzeczy do zrobienia.</h2>
        <p>Potrzebujesz narzędzia, które rozumie, że nauka to proces: od pierwszej notatki aż po ostatnią powtórkę przed egzaminem.</p>
      </div>
      <div class="loop" aria-label="Cykl pracy w Sylabio">
        <div class="loop-center"><strong>Sylabio</strong><small>Twój rytm nauki</small></div>
        <span class="loop-item item-1">Notuj</span><span class="loop-item item-2">Pytaj</span><span class="loop-item item-3">Powtarzaj</span><span class="loop-item item-4">Sprawdzaj</span>
      </div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="shell faq-grid">
      <div><p class="section-kicker">Pytania i odpowiedzi</p><h2 class="section-title">Zanim zaczniesz</h2><p class="section-lead">Masz inne pytanie? <a href="/contact">Napisz do nas.</a></p></div>
      <div class="faq-list">
        {faqs.map(([question, answer], index) => (
          <details open={index === 0}><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="shell cta-inner">
      <div><p class="section-kicker">Zacznij od jednego materiału</p><h2>Twój egzamin. Twój plan.<br/>Spokojniejsza głowa.</h2></div>
      <div><a class="button cta-button" href={appLinks.signUp}>Utwórz darmowe konto <span>→</span></a><p>Bez karty płatniczej. Zajmie Ci to minutę.</p></div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { position: relative; overflow: hidden; padding: 7.5rem 0 0; background: radial-gradient(circle at 80% 10%, rgba(142,215,204,.28), transparent 28%), linear-gradient(180deg, #f7faf8, #eef7f3 88%, #e7f1ed); }
  .hero::before { position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(rgba(24,95,87,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(24,95,87,.035) 1px, transparent 1px); background-size: 34px 34px; mask-image: linear-gradient(to bottom, black, transparent 70%); content: ""; }
  .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 780px) 1fr; gap: 2rem; align-items: end; }
  .eyebrow { display: flex; align-items: center; gap: .7rem; margin: 0 0 1.35rem; color: var(--brand); font-size: .78rem; font-weight: 760; letter-spacing: .12em; text-transform: uppercase; }.eyebrow span { width: 2rem; height: 1px; background: currentColor; }
  h1 { max-width: 800px; margin: 0; font-size: clamp(3rem, 7vw, 6.1rem); font-weight: 700; line-height: .98; letter-spacing: -.072em; } h1 em { color: var(--brand); font-style: normal; }
  .hero-lead { max-width: 660px; margin: 1.7rem 0 0; color: var(--ink-soft); font-size: clamp(1.05rem, 2vw, 1.3rem); }
  .hero-actions { display: flex; align-items: center; gap: 1.4rem; margin-top: 2.2rem; }.hero-actions .button { gap: 1rem; }.tour-link { display: inline-flex; align-items: center; gap: .65rem; color: var(--ink); font-weight: 650; text-decoration: none; }.play { display: grid; width: 2.35rem; height: 2.35rem; place-items: center; padding-left: .12rem; border: 1px solid var(--line); border-radius: 50%; color: var(--brand); background: white; font-size: .65rem; }
  .hero-proof { display: flex; flex-wrap: wrap; gap: 1.4rem; margin-top: 2rem; color: #647d7a; font-size: .8rem; }.hero-proof span { display: flex; align-items: center; gap: .38rem; }.hero-proof i { color: var(--brand); font-style: normal; font-weight: 800; }
  .hero-note { align-self: center; position: relative; max-width: 220px; margin-top: 7rem; padding: 1.15rem 1.25rem; color: #6f5b2d; background: #fff4c9; box-shadow: 0 14px 34px rgba(94,75,27,.12); font-family: var(--font-display); font-size: .88rem; transform: rotate(2deg); }.hero-note p { margin: 0; }.note-dot { position: absolute; top: .55rem; left: 50%; width: .45rem; height: .45rem; border-radius: 50%; background: #d7b957; }.hero-note svg { position: absolute; right: -2rem; bottom: -4rem; width: 7rem; color: #9b8445; transform: rotate(-12deg); }
  .hero-preview { position: relative; z-index: 2; margin-top: 5rem; transform: translateY(2.6rem); }
  .signal-bar { padding: 5rem 0 2rem; background: white; }.signals { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 1rem 1.5rem; color: #708783; font-size: .82rem; font-weight: 650; letter-spacing: .04em; text-transform: uppercase; }.signals i { color: var(--mint); font-style: normal; }
  .story { background: white; }.story-heading { display: grid; grid-template-columns: 1.4fr 1fr; gap: 4rem; align-items: end; }.story-heading .section-lead { margin: 0; }.steps { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 4.5rem; }.step { position: relative; padding-right: 3rem; }.step-number { display: block; color: var(--brand); font-family: var(--font-display); font-size: .85rem; font-weight: 800; }.step-line { height: 1px; margin: 1.1rem 0 1.6rem; background: var(--line); }.step-line::before { display: block; width: .6rem; height: .6rem; border: 2px solid var(--brand); border-radius: 50%; background: white; content: ""; transform: translateY(-50%); }.step h3 { margin: 0 0 .7rem; font-size: 1.35rem; }.step p { margin: 0; color: var(--ink-soft); font-size: .93rem; }
  .plan-section { background: #eff7f4; }.plan-section .section-kicker { color: var(--brand-dark); }.plan-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(3rem, 8vw, 7rem); align-items: center; }.plan-visual { position: relative; padding: 2.5rem; }.plan-visual::before { position: absolute; inset: 0; border-radius: 50%; background: rgba(142,215,204,.25); filter: blur(40px); content: ""; }.calendar-card { position: relative; padding: 1.4rem; border: 1px solid #d8e6e3; border-radius: 1.2rem; background: rgba(255,255,255,.94); box-shadow: var(--shadow-lg); }.calendar-top { display: flex; align-items: center; justify-content: space-between; }.calendar-top div { display: grid; }.calendar-top small { color: #7a928f; font-size: .6rem; font-weight: 800; letter-spacing: .1em; }.calendar-top strong { margin-top: .2rem; }.calendar-top > span { padding: .35rem .6rem; border-radius: 2rem; color: #276d64; background: var(--mint-soft); font-size: .7rem; font-weight: 700; }.week, .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: .4rem; }.week { margin-top: 1.5rem; color: #91a19f; font-size: .58rem; text-align: center; }.week i { font-style: normal; }.calendar-grid { margin-top: .5rem; }.calendar-grid span { display: grid; aspect-ratio: 1; place-items: center; border-radius: .55rem; color: #6d8581; background: #f5f8f7; font-size: .7rem; }.calendar-grid span.filled { color: #215f57; background: #dff2ee; font-weight: 700; }.calendar-grid span.today { color: white; background: var(--brand); box-shadow: 0 5px 13px rgba(38,126,115,.25); }.calendar-grid span.future { opacity: .55; }.pace { display: flex; align-items: center; justify-content: space-between; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--line); font-size: .68rem; }.pace span { display: flex; align-items: center; gap: .4rem; color: var(--ink-soft); }.pace i { width: .5rem; height: .5rem; border-radius: 50%; background: #59ad78; }.pace strong { color: #36735a; }.float-card { position: absolute; display: grid; min-width: 8rem; padding: .8rem 1rem; border: 1px solid var(--line); border-radius: .8rem; background: white; box-shadow: 0 12px 30px rgba(18,49,47,.13); }.float-card strong { color: var(--brand-dark); font-family: var(--font-display); font-size: 1.25rem; }.float-card small { color: var(--ink-soft); font-size: .65rem; }.card-a { top: 0; right: -1rem; transform: rotate(3deg); }.card-b { bottom: .5rem; left: -.5rem; transform: rotate(-3deg); }.plan-copy ul { display: grid; gap: 1rem; margin: 2rem 0 0; padding: 0; list-style: none; }.plan-copy li { display: flex; gap: .9rem; }.plan-copy li > span { display: grid; flex: 0 0 auto; width: 1.6rem; height: 1.6rem; place-items: center; margin-top: .1rem; border-radius: 50%; color: var(--brand); background: var(--mint-soft); font-weight: 800; }.plan-copy li strong { font-size: .94rem; }.plan-copy li p { margin: .1rem 0 0; color: var(--ink-soft); font-size: .86rem; }
  .feature-section { background: white; }.feature-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; margin-top: 3.5rem; overflow: hidden; border: 1px solid var(--line); border-radius: 1.2rem; background: var(--line); }.feature { min-height: 250px; padding: 2.3rem; background: white; }.feature:nth-child(2), .feature:nth-child(3) { background: #fbfdfc; }.feature-icon { display: grid; width: 2.7rem; height: 2.7rem; place-items: center; border-radius: .8rem; color: var(--brand); background: var(--mint-soft); font-size: 1.25rem; }.feature h3 { max-width: 380px; margin: 1.5rem 0 .7rem; font-size: 1.5rem; }.feature p { max-width: 460px; margin: 0; color: var(--ink-soft); }.feature-link { display: flex; width: fit-content; align-items: center; gap: .8rem; margin: 2rem 0 0 auto; color: var(--brand-dark); font-weight: 700; text-decoration: none; }.feature-link span { font-size: 1.3rem; }
  .quote-section { color: white; background: #123b38; }.quote-grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 5rem; }.quote-mark { color: var(--mint); font-family: Georgia, serif; font-size: 6rem; line-height: .5; }.quote-copy h2 { max-width: 600px; margin: 1.4rem 0; font-size: clamp(2.2rem, 4.6vw, 4rem); }.quote-copy p { max-width: 570px; color: #b5cfcb; font-size: 1.05rem; }.loop { position: relative; aspect-ratio: 1; max-width: 440px; margin: auto; border: 1px solid #37615d; border-radius: 50%; }.loop::before { position: absolute; inset: 17%; border: 1px dashed #547874; border-radius: 50%; content: ""; }.loop-center { position: absolute; inset: 34%; display: grid; place-content: center; border-radius: 50%; color: #123b38; background: var(--mint); text-align: center; }.loop-center strong { font-family: var(--font-display); font-size: 1.2rem; }.loop-center small { font-size: .55rem; }.loop-item { position: absolute; padding: .45rem .7rem; border: 1px solid #567c77; border-radius: 2rem; color: #d8e9e6; background: #1b4945; font-size: .72rem; font-weight: 700; }.item-1 { top: 7%; left: 40%; }.item-2 { top: 45%; right: -3%; }.item-3 { bottom: 5%; left: 38%; }.item-4 { top: 45%; left: -5%; }
  .faq-section { background: white; }.faq-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 6rem; align-items: start; }.faq-grid .section-lead { font-size: .95rem; }.faq-grid .section-lead a { color: var(--brand); font-weight: 700; }.faq-list { border-top: 1px solid var(--line); }.faq-list details { border-bottom: 1px solid var(--line); }.faq-list summary { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: 1.35rem 0; cursor: pointer; font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; list-style: none; }.faq-list summary::-webkit-details-marker { display: none; }.faq-list summary span { color: var(--brand); font-size: 1.4rem; font-weight: 400; transition: transform .2s ease; }.faq-list details[open] summary span { transform: rotate(45deg); }.faq-list details p { margin: -.35rem 2rem 1.35rem 0; color: var(--ink-soft); font-size: .92rem; }
  .cta-section { padding: 5rem 0; color: white; background: var(--brand); }.cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 3rem; }.cta-section .section-kicker { color: white; }.cta-section h2 { margin: 0; font-size: clamp(2.1rem, 4vw, 3.5rem); }.cta-inner > div:last-child { text-align: center; }.cta-button { border-color: white; color: var(--brand-dark); background: white; box-shadow: 0 12px 28px rgba(10,51,47,.2); }.cta-button:hover { color: var(--brand-dark); background: #f7fffd; }.cta-inner > div:last-child p { margin: .65rem 0 0; color: white; font-size: .75rem; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; }.hero-note { display: none; }.story-heading, .plan-grid, .quote-grid, .faq-grid { grid-template-columns: 1fr; gap: 3rem; }.story-heading .section-lead { margin-top: 1rem; }.plan-visual { max-width: 620px; }.quote-grid { gap: 4rem; }.loop { width: min(100%, 380px); }.faq-grid { gap: 2rem; } }
  @media (max-width: 680px) { .hero { padding-top: 4.8rem; }.hero-actions { align-items: stretch; flex-direction: column; }.tour-link { justify-content: center; }.hero-proof { gap: .6rem 1rem; }.hero-preview { margin-top: 3.5rem; }.signals { gap: .6rem 1rem; font-size: .68rem; }.steps { grid-template-columns: 1fr; gap: 2.5rem; margin-top: 3rem; }.step { padding-right: 0; }.plan-visual { padding: 1rem 0; }.float-card { display: none; }.feature-grid { grid-template-columns: 1fr; }.feature { min-height: 0; padding: 1.6rem; }.cta-inner { align-items: stretch; flex-direction: column; }.cta-inner > div:last-child { text-align: left; }.cta-button { width: 100%; }.loop-item { font-size: .6rem; }.item-2 { right: -1%; }.item-4 { left: -1%; } }
</style>
