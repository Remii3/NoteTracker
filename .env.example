VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_R2_IMAGES_API_URL=https://notetracker-topic-images.your-account.workers.dev

# Optional production monitoring. The DSN is a public client identifier.
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=

# Build-only Sentry secrets. Configure them in Vercel, never in VITE_* variables.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
